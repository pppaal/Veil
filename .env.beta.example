# Settings for the Android beta in docs/android-beta-today.md: the demo stack
# (docker-compose.demo.yml) behind a Cloudflare Tunnel, for invited testers.
#
#   cp .env.beta.example .env.beta      # git ignores .env.beta
#   # fill in every line that says replace
#   docker compose --env-file .env.beta -f docker-compose.demo.yml --profile tunnel up -d --build
#
# A line left as `replace` stops that part from starting, on purpose: the API
# refuses a JWT secret or pepper under 32 characters or a files address that
# is not a URL, and MinIO refuses a password under 8 characters.

# From Cloudflare: Networks > Tunnels > your tunnel. The long token that
# starts with eyJ.
CLOUDFLARE_TUNNEL_TOKEN=replace

# Your two public hostnames from the tunnel, with https:// and no slash at the
# end. The first one is routed to http://api:3000, the second to
# http://minio:9000. Example: https://veil.example.com and
# https://veil-files.example.com
VEIL_ALLOWED_ORIGINS=replace
VEIL_S3_PUBLIC_ENDPOINT=replace

# Each one: the output of `openssl rand -hex 32`. Make the pepper once and
# keep it: it keys the hold on deleted handles.
VEIL_JWT_SECRET=replace
VEIL_RETIRED_HANDLE_PEPPER=replace

# The files hostname makes MinIO reachable from the internet, so it must not
# keep the demo's minioadmin keys. Password: the output of `openssl rand -hex 24`.
VEIL_MINIO_ROOT_USER=veil-files
VEIL_MINIO_ROOT_PASSWORD=replace

# Keep these as they are. cloudflared reaches the API and MinIO over the
# compose network, so their host ports stay on this machine; the rate limiter
# reads the client address Cloudflare passes on.
VEIL_CLIENT_IP_SOURCE=cf-connecting-ip
VEIL_API_BIND_ADDRESS=127.0.0.1
VEIL_DATA_BIND_ADDRESS=127.0.0.1
VEIL_ENABLE_SWAGGER=false

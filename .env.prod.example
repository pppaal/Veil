# VEIL production environment template.
# Copy to .env.prod and fill in. Never commit .env.prod.

# ---- Public hostnames ----
# Caddy issues TLS for both. They MUST resolve to the VPS public IP.
CADDY_PUBLIC_HOSTNAME=veil.example.com
CADDY_S3_HOSTNAME=s3.veil.example.com
ACME_EMAIL=ops@example.com

# Origin the API trusts for CORS. Same as CADDY_PUBLIC_HOSTNAME, with scheme.
VEIL_ALLOWED_ORIGINS=https://veil.example.com
# Public S3 endpoint that browsers/phones use for presigned PUTs.
VEIL_S3_PUBLIC_ENDPOINT=https://s3.veil.example.com

# ---- Postgres ----
POSTGRES_DB=veil
POSTGRES_USER=veil
# openssl rand -base64 32
POSTGRES_PASSWORD=replace-me

# ---- Redis ----
# openssl rand -base64 32
REDIS_PASSWORD=replace-me

# ---- MinIO ----
MINIO_ROOT_USER=replace-me-min-12-chars
# openssl rand -base64 32
MINIO_ROOT_PASSWORD=replace-me-min-32-chars
MINIO_BUCKET=veil-encrypted

# ---- API ----
# openssl rand -base64 32
VEIL_JWT_SECRET=replace-me
# openssl rand -base64 32. Keys the HMAC that quarantines deleted handles.
# Generate it once and never rotate it: a new pepper makes existing
# retired_handles rows unmatchable, so quarantined handles become claimable
# early. Left empty on purpose: compose refuses to start until it is set.
VEIL_RETIRED_HANDLE_PEPPER=
VEIL_JWT_AUDIENCE=veil-mobile
VEIL_JWT_ISSUER=veil-api
VEIL_LOG_LEVEL=info
VEIL_S3_REGION=us-east-1

# Production gate. MUST stay false until external crypto audit clears
# the LibCryptoAdapter and external-review-remediation-tracker is empty.
# Setting this to true otherwise is a policy violation. Only true/false
# (or 1/0, yes/no) are accepted; any other value fails boot.
VEIL_AUDITED_CRYPTO_ATTESTED=false
# sha256sum of the signed external audit report (64 lowercase hex chars).
# The API refuses to boot in production while this is empty.
VEIL_AUDIT_REPORT_SHA256=

# Push delivery — disabled in private beta. Set to a valid provider once
# APNs/FCM credentials and the privacy review have shipped.
VEIL_PUSH_PROVIDER=none
VEIL_PUSH_ENABLE_DELIVERY=false
# Required when VEIL_PUSH_PROVIDER=unifiedpush: comma-separated distributor
# hosts (subdomains included), e.g. ntfy.sh,push.example.org.
VEIL_UNIFIEDPUSH_ALLOWED_HOSTS=

# The rate limiter reads client addresses from X-Forwarded-For, which Caddy
# overwrites (docker-compose.prod.yml sets VEIL_CLIENT_IP_SOURCE). There is
# no VEIL_TRUST_PROXY any more; setting it fails boot.

# ---- Metrics ----
# Bearer token for /v1/metrics scrape. Empty disables the endpoint.
# openssl rand -hex 24
VEIL_METRICS_AUTH_TOKEN=replace-me

# ---- Grafana ----
# openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=replace-me

# ---- Backups ----
# The postgres-backup service dumps the DB to the veil_prod_backups volume.
# Retention in days; dumps older than this are pruned. Interval in seconds
# between dumps (default 24h). See docs/vps-deploy-runbook.md section 6.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
